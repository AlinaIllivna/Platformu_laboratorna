@page
@model LibraryRazorApp.Pages_Books.IndexModel

@{
    ViewData["Title"] = "Книги";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-book-half text-primary me-2"></i>Каталог книг</h2>
    <a asp-page="Create" class="btn btn-primary btn-custom-primary">
        <i class="bi bi-plus-circle me-1"></i> Додати книгу
    </a>
</div>

<div class="table-responsive table-custom">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Назва</th>
                <th>Автор</th>
                <th>Рік видання</th>
                <th class="text-end pe-4">Дії</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model.Book) {
            <tr>
                <td class="fw-bold">@item.Title</td>
                <td>@item.Author</td>
                <td><span class="badge bg-secondary fs-6">@item.Year</span></td>
                <td class="text-end pe-4 action-links">
                    <a asp-page="./Edit" asp-route-id="@item.ID" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                    <a asp-page="./Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-info"><i class="bi bi-info-circle"></i></a>
                    <a asp-page="./Delete" asp-route-id="@item.ID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>