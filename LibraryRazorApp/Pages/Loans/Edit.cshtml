@page "{id:int}"
@model LibraryRazorApp.Pages_Loans.EditModel

@{
    ViewData["Title"] = "Редагування видачі";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card-custom">
            <h3 class="mb-4 text-warning"><i class="bi bi-pencil-square me-2"></i>Редагування видачі книги</h3>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Loan.ID" />

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Читач</label>
                    <select asp-for="Loan.ReaderID" class="form-select" asp-items="Model.ReaderList" required>
                        <option value="">-- Оберіть читача --</option>
                    </select>
                    <span asp-validation-for="Loan.ReaderID" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Книга</label>
                    <select asp-for="Loan.BookID" class="form-select" asp-items="Model.BookList" required>
                        <option value="">-- Оберіть книгу --</option>
                    </select>
                    <span asp-validation-for="Loan.BookID" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Дата видачі</label>
                    <input asp-for="Loan.IssueDate" class="form-control" type="date" required />
                    <span asp-validation-for="Loan.IssueDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Дата повернення</label>
                    <input asp-for="Loan.ReturnDate" class="form-control" type="date" />
                    <span asp-validation-for="Loan.ReturnDate" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Назад</a>
                    <button type="submit" class="btn btn-warning text-white btn-custom-primary"><i class="bi bi-check-lg"></i> Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}