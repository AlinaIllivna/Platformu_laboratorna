@page "{id:int}"
@model LibraryRazorApp.Pages_Loans.DetailsModel

@{
    ViewData["Title"] = "Деталі видачі";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card-custom">
            <h3 class="mb-4 text-info"><i class="bi bi-info-square me-2"></i>Деталі видачі книги</h3>

            <dl class="row fs-6">
                <dt class="col-sm-4 text-muted">Читач:</dt>
                <dd class="col-sm-8 fw-bold">@(Model.Loan.Reader?.FullName ?? $"Читач #{Model.Loan.ReaderID}")</dd>

                <dt class="col-sm-4 text-muted">Книга:</dt>
                <dd class="col-sm-8">@(Model.Loan.Book?.Title ?? $"Книга #{Model.Loan.BookID}")</dd>

                <dt class="col-sm-4 text-muted">Дата видачі:</dt>
                <dd class="col-sm-8">@Model.Loan.IssueDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4 text-muted">Статус повернення:</dt>
                <dd class="col-sm-8">
                    @if (Model.Loan.ReturnDate.HasValue)
                    {
                        <span class="badge bg-success fs-6">Повернуто (@Model.Loan.ReturnDate.Value.ToString("yyyy-MM-dd"))</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6">На руках</span>
                    }
                </dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Назад до списку</a>
                <a asp-page="./Edit" asp-route-id="@Model.Loan.ID" class="btn btn-warning text-white"><i class="bi bi-pencil"></i> Редагувати</a>
            </div>
        </div>
    </div>
</div>