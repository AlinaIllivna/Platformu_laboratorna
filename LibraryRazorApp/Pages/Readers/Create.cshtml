@page
@model LibraryRazorApp.Pages_Readers.CreateModel

@{
    ViewData["Title"] = "Створення читача";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card-custom">
            <h3 class="mb-4 text-primary"><i class="bi bi-person-plus me-2"></i>Створення нового читача</h3>
            
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Номер квитка</label>
                    <input asp-for="Reader.TicketNumber" class="form-control" type="number" min="1" required placeholder="Наприклад: 101" />
                    <span asp-validation-for="Reader.TicketNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">ПІБ читача</label>
                    <input asp-for="Reader.FullName" class="form-control" required minlength="3" placeholder="Петренко Петро Петрович" />
                    <span asp-validation-for="Reader.FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input asp-for="Reader.Email" class="form-control" type="email" placeholder="example@gmail.com" />
                    <span asp-validation-for="Reader.Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Адреса</label>
                    <input asp-for="Reader.Address" class="form-control" placeholder="м. Чернівці, вул. Головна, 1" />
                    <span asp-validation-for="Reader.Address" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label fw-bold">Телефон</label>
                    <input asp-for="Reader.Phone" class="form-control" type="tel" pattern="\+?\d{10,12}" placeholder="+380991234567" />
                    <span asp-validation-for="Reader.Phone" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Назад</a>
                    <button type="submit" class="btn btn-primary btn-custom-primary"><i class="bi bi-check-lg"></i> Зберегти</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}