@page "{id:int}"
@model LibraryRazorApp.Pages_Readers.DetailsModel

@{
    ViewData["Title"] = "Деталі читача";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card-custom">
            <h3 class="mb-4 text-info"><i class="bi bi-person-badge me-2"></i>Інформація про читача</h3>
            
            <dl class="row fs-6">
                <dt class="col-sm-4 text-muted">Номер квитка:</dt>
                <dd class="col-sm-8"><span class="badge bg-secondary fs-6">@Model.Reader.TicketNumber</span></dd>

                <dt class="col-sm-4 text-muted">ПІБ:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Reader.FullName</dd>

                <dt class="col-sm-4 text-muted">Email:</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Reader.Email) ? "—" : Model.Reader.Email)</dd>

                <dt class="col-sm-4 text-muted">Адреса:</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Reader.Address) ? "—" : Model.Reader.Address)</dd>

                <dt class="col-sm-4 text-muted">Телефон:</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Reader.Phone) ? "—" : Model.Reader.Phone)</dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-page="./Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Назад</a>
                <a asp-page="./Edit" asp-route-id="@Model.Reader.ID" class="btn btn-warning text-white"><i class="bi bi-pencil"></i> Редагувати</a>
            </div>
        </div>
    </div>
</div>