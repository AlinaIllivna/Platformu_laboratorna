@page
@model LibraryRazorApp.Pages_Readers.IndexModel

@{
    ViewData["Title"] = "Читачі";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people-fill text-primary me-2"></i>Список читачів</h2>
    <a asp-page="Create" class="btn btn-primary btn-custom-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Додати читача
    </a>
</div>

<div class="table-responsive table-custom">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Номер квитка</th>
                <th>ПІБ</th>
                <th>Email</th>
                <th>Адреса</th>
                <th>Телефон</th>
                <th class="text-end pe-4">Дії</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model.Reader) {
            <tr>
                <td><span class="badge bg-secondary">@item.TicketNumber</span></td>
                <td class="fw-bold">@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>@item.Phone</td>
                <td class="text-end pe-4 action-links">
                    <a asp-page="./Edit" asp-route-id="@item.ID" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                    <a asp-page="./Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-info"><i class="bi bi-info-circle"></i></a>
                    <a asp-page="./Delete" asp-route-id="@item.ID" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>