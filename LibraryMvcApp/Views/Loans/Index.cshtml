@model IEnumerable<LibraryMvcApp.Models.Loan>

@{
    ViewData["Title"] = "Видача книг";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Видача книг</h1>
    <a asp-action="Create" class="btn btn-success">+ Нова видача</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Книга</th>
            <th>Читач</th>
            <th>Дата видачі</th>
            <th>Дата повернення</th>
            <th class="text-end">Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Book?.Title</td>
            <td>@item.Reader?.FullName</td>
            <td>@item.IssueDate.ToString("dd.MM.yyyy")</td>
            <td>
                @if (item.ReturnDate.HasValue)
                {
                    @item.ReturnDate.Value.ToString("dd.MM.yyyy")
                }
                else
                {
                    <span class="badge bg-warning text-dark">Не повернено</span>
                }
            </td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Змінити</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Деталі</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>