@model IEnumerable<LibraryMvcApp.Models.Book>

@{
    ViewData["Title"] = "Книги";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Книги</h1>
    <a asp-action="Create" class="btn btn-success">+ Додати книгу</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Назва</th>
            <th>Автор</th>
            <th>Рік видання</th>
            <th class="text-end">Дії</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.Year</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Змінити</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Деталі</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
            </td>
        </tr>
}
    </tbody>
</table>